  max_capacity Int // số lượng khách nhiều nhất

  shape         TableShape?
  color         String?
  is_combinable Boolean?    @default(false) // cho phép ghép table vs người khác hay không

  pos_x    Float? //  sơ đồ tọa độ X
  pos_y    Float? //  tọa độ Y
  width    Float? @default(80) // Chiều rộng hiển thị trên sơ đồ
  height   Float? @default(80) // Chiều cao hiển thị trên sơ đồ
  rotation Float? @default(0) // Góc xoay của bàn

  status TableStatus @default(ACTIVE)

  qr_code            String?              @unique // mở link để đặt món tiếp
  reservation_tables Reservation_Tables[] // bàn đc phân khi có đơn đặt 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  maintenanceScheduleIds String[]                      @db.ObjectId
  maintenance_schedules  Table_Maintenance_Schedules[] @relation(fields: [maintenanceScheduleIds], references: [id])

  @@unique([restaurantId, table_number])
  @@map("tables")
}

model Tags {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  slug        String   @unique
  description String?
  textColor   String?  @default("#000000")
  bgColor     String?  @default("#f3f4f6")
  createdAt   DateTime @default(now())

  restaurantIds String[]     @db.ObjectId
  restaurants   Restaurant[] @relation(fields: [restaurantIds], references: [id])

  @@map("tags")
}

model Template {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  code         String       @unique
  type         TemplateType
  thumbnailUrl String?
  description  String?

  desktopImages String[]
  mobileImages  String[]
  tabletImages  String[]

  isActive Boolean @default(true)

  allowedPlanIds String[] @db.ObjectId

  brands      Brand[]
  restaurants Restaurant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("templates")
}
