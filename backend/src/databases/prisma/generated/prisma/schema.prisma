model Category_Restaurant {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  name          String       @unique // VD: Lẩu, Nướng, Chay, Hàn Quốc...
  isActive      Boolean      @default(true)
  description   String?
  bgColor       String?      @default("#EEF2FF") // Default indigo-50
  textColor     String?      @default("#000000ff") // Default indigo-500
  // Quan hệ ngược lại với Restaurant
  restaurantIds String[]     @db.ObjectId
  restaurants   Restaurant[] @relation(fields: [restaurantIds], references: [id])

  @@index([isActive])
  @@map("category_restaurant")
}

// 7. BẢNG PHÂN CÔNG CÔNG VIỆC (Mảnh ghép quan trọng nhất)
// Trả lời câu hỏi: Ai? Làm chức vụ gì? Ở đâu?
model Employment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // AI?
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  // LÀM CHỨC VỤ GÌ?
  workspaceRoleId String?                    @db.ObjectId
  workspaceRole   WorkspaceRole?             @relation(fields: [workspaceRoleId], references: [id])
  per_vs_emp      Permission_vs_Employment[]

  // Ở ĐÂU? (Ngữ cảnh)
  brandId String? @db.ObjectId
  brand   Brand?  @relation(fields: [brandId], references: [id])

  restaurantId String?     @db.ObjectId
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])

  // lương
  salary_type salary_type? // tính theo giờ or tháng sau này mở rộng ra table khác

  createdAt DateTime @default(now()) // cho biết ngày vào làm
  updatedAt DateTime @updatedAt // cho biết cập nhật lúc nào

  // Đảm bảo 1 user không bị gán trùng 1 role ở cùng 1 nhà hàng 2 lần
  reservations       Reservations[] // nhân viên phụ trách đặt bàn cho khách 
  reservation_tables Reservation_Tables[] // nhân viên phụ trách phân table nếu có 

  @@unique([userId, restaurantId])
  @@map("employments")
}

model ItemCategoryMap {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  categoryId String       @db.ObjectId
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  menuItemId String   @db.ObjectId
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  sort_order Int @default(0)

  @@unique([categoryId, menuItemId])
  @@index([categoryId])
  @@index([menuItemId])
  @@map("item_category_maps")
}

model ItemVariant {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  menuItemId String @db.ObjectId
  name       String // e.g. "Size S", "Size M"
  sku        String @unique
  price      Float // Giá thay thế cho basePrice

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  recipes  Recipe[]

  @@map("item_variants")
}

model MenuCategory {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  menuId String @db.ObjectId
  menu   Menu   @relation(fields: [menuId], references: [id])

  name        String
  description String?
  image_url   String?

  sort_order Int     @default(0)
  is_active  Boolean @default(true)

  items            MenuItem[]
  itemCategoryMaps ItemCategoryMap[]
  menuCategoryMaps MenuCategoryMap[]

  // @@unique([menuId, name]) // Tạm thời comment vì data hiện tại đang có duplicate
  @@index([menuId])
  @@map("menu_categories")
}

model MenuCategoryMap {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  menuId String @db.ObjectId
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  categoryId String       @db.ObjectId
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  sort_order Int @default(0)

  @@unique([menuId, categoryId])
  @@index([menuId])
  @@index([categoryId])
  @@map("menu_category_maps")
}

model ModifierGroup {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  menuItemId    String @db.ObjectId
  name          String // e.g. "Lượng Đường", "Thêm Topping"
  minSelections Int    @default(0)
  maxSelections Int    @default(1)

  menuItem MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  ModifierOption[]

  @@map("modifier_groups")
}

model ModifierOption {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  modifierGroupId String @db.ObjectId
  name            String
  priceExtra      Float  @default(0) // Phụ thu

  group   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  recipes Recipe[]

  @@map("modifier_options")
}

model Notifications {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  reservationId String?       @db.ObjectId
  reservation   Reservations? @relation(fields: [reservationId], references: [id])

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  type    NotificationType? // loại thông báo 
  channel NotificationChannel? // thuộc loại nào để gửi đến

  recipient String // người nhận

  subject String? // tiêu đề thông báo
  body    String? // nội dung thông báo

  status NotificationStatus

  sent_at      DateTime? // thời điểm gửi thông báo 
  delivered_at DateTime? // thời điểm thông báo đc nhận 

  external_id   String?
  error_message String?

  // ⭐ thêm cho web notification
  is_read Boolean   @default(false)
  read_at DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([reservationId])
  @@index([status])
  @@map("notifications")
}

model Promotion {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  code            String  @unique
  description     String?
  discount_type   String // PERCENTAGE hoặc FIXED_AMOUNT
  discount_value  Float
  min_order_value Float?
  max_discount    Float?

  valid_from  DateTime
  valid_until DateTime
  usage_limit Int? // Tổng số lần mã có thể dùng
  used_count  Int      @default(0)

  brandId      String? @db.ObjectId
  restaurantId String? @db.ObjectId

  promotionRestaurants PromotionRestaurant[]
  promotionMenuItems   PromotionMenuItem[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("promotions")
}

model PromotionRestaurant {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  promotionId  String @db.ObjectId
  restaurantId String @db.ObjectId

  promotion  Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("promotion_restaurants")
}

model PromotionMenuItem {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  promotionId String @db.ObjectId
  menuItemId  String @db.ObjectId

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("promotion_menu_items")
}

model Recipe {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  inventoryItemId String @db.ObjectId

  menuItemId       String? @db.ObjectId
  variantId        String? @db.ObjectId
  modifierOptionId String? @db.ObjectId

  quantityRequired Float

  inventoryItem  InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  menuItem       MenuItem?       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  variant        ItemVariant?    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  modifierOption ModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: Cascade)

  @@map("recipes")
}

model RestaurantMenuItem {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId String @db.ObjectId
  menuItemId   String @db.ObjectId

  isAvailable   Boolean @default(true) // Hết hàng cục bộ
  overridePrice Float? // Giá bán ghi đè

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, menuItemId])
  @@map("restaurant_menu_items")
}

model RestaurantPaymentConfig {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  restaurantId String @db.ObjectId
  brandId      String @db.ObjectId

  provider PaymentMethod

  // JSON config (MongoDB rất hợp cho field này)
  configData Json

  isActive   Boolean @default(true)
  isTestMode Boolean @default(true)

  createdAt DateTime @default(now())

  // Relations (optional nếu bạn đã có model)
  restaurant            Restaurant           @relation(fields: [restaurantId], references: [id])
  brand                 Brand                @relation(fields: [brandId], references: [id])
  systemPaymentMethod   SystemPaymentMethod? @relation(fields: [systemPaymentMethodId], references: [id])
  systemPaymentMethodId String?              @db.ObjectId

  @@unique([restaurantId, provider])
  @@map("restaurant_payment_configs")
}

model SystemRole {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  @unique
  description String?
  users       User[]

  @@map("SystemRole")
}

model Transaction {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  orderId String @db.ObjectId
  amount  Float

  provider PaymentMethod

  externalTransactionId String?

  status TransactionStatus

  rawResponse Json?

  createdAt DateTime @default(now())

  // Relation
  order                 Order                @relation(fields: [orderId], references: [id])
  systemPaymentMethod   SystemPaymentMethod? @relation(fields: [systemPaymentMethodId], references: [id])
  systemPaymentMethodId String?              @db.ObjectId

  @@index([orderId])
  @@index([externalTransactionId])
  @@map("transactions")
}

model UpgradeRequest {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId // Mỗi user chỉ có 1 request chờ duyệt tại 1 thời điểm
  user   User   @relation(fields: [userId], references: [id])

  // Các thông tin user phải nộp để xin lên quản lý
  brandName       String // Tên thương hiệu muốn tạo
  tax_code        String? // Mã số thuế (nếu cần)
  businessLicense String? // Ảnh chụp giấy phép KD (URL từ Cloudinary)

  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status]) // Tối ưu cho query: đếm số đơn PENDING của Admin
  @@index([createdAt]) // Tối ưu cho việc Admin sort đơn mới nhất lên đầu
  @@index([userId, status]) // Compound Index: Tối ưu cho việc check xem User này có đơn nào đang PENDING không
  @@map("upgrade_request")
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  user_name    String        @unique
  email        String        @unique
  sdt          String?
  password     String?
  providerId   String?
  providerType providerType?
  // thông tin cơ bản

  name          String?
  avatar        String?
  gender        Gender?
  date_of_birth DateTime?
  is_active     AccountStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //tạo liên kết 

  // --- Các Relations (Liên kết tới các vai trò của User) ---
  employments                        Employment[] // Liên kết: User này làm nhân viên ở đâu? có or ko 
  systemRoleId                       String?                             @db.ObjectId // Liên kết : User này là khách hàng hay admin
  systemRole                         SystemRole?                         @relation(fields: [systemRoleId], references: [id])
  reservations                       Reservations[] //khách hàng đặt bàn
  review_restaurant                  Review_Restaurant[] // người đánh fias nhà hàng
  reservation_audit_log              Reservation_Audit_Log[] // thay đổi đặt 
  notifications                      Notifications[]
  ordersTaken                        Order[]                             @relation("EmployeeOrders")
  upgradeRequest                     UpgradeRequest?
  brandNotificationReadReceipts      BrandNotificationReadReceipt[]
  brandSubscriptionTransactions      BrandSubscriptionTransaction[]
  customerNotifications              CustomerNotification[]
  restaurantCustomers                RestaurantCustomer[]
  restaurantNotificationReadReceipts RestaurantNotificationReadReceipt[]
  systemNotificationReadReceipts     SystemNotificationReadReceipt[]

  @@index([systemRoleId])
  @@index([name])
  @@index([sdt])
  @@map("users")
}

model WorkspaceRole {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String       @unique
  description String?
  employments Employment[]

  @@map("WorkspaceRole")
}

type LocationAddress {
  street       String?
  ward         String?
  wardCode     String?
  district     String?
  districtCode String?
  province     String?
  provinceCode String?
  latitude     Float?
  longitude    Float?
}

model AdminPaymentConfig {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  systemPaymentMethodId String @db.ObjectId

  // JSON config (API Keys, Checksum Keys của Admin)
  configData Json

  isActive   Boolean @default(true)
  isTestMode Boolean @default(true)

  verificationStatus ConfigVerificationStatus @default(UNVERIFIED)
  lastVerifiedAt     DateTime?
  lastTestOrderCode  String? // Dùng để track mã đơn hàng test 1000đ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  systemPaymentMethod SystemPaymentMethod @relation(fields: [systemPaymentMethodId], references: [id])

  @@unique([systemPaymentMethodId])
  @@map("admin_payment_configs")
}

model AIChatSession {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  brandId String @db.ObjectId
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  restaurantId String?     @db.ObjectId
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  platform      ChatPlatform @default(WEB) // Nền tảng (ZALO, FACEBOOK, WEB)
  externalId    String? // ID của người dùng trên nền tảng (Zalo ID, FB PSID)
  customerName  String?
  customerPhone String?

  status SessionStatus @default(ACTIVE) // ACTIVE, RESOLVED, ESCALATED (chuyển cho nhân viên thật)

  messages AIChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([externalId])
  @@index([createdAt]) // Cần tạo TTL Index trên MongoDB để tự xóa sau 30 ngày tránh phình DB
  @@map("ai_chat_sessions")
}

model AIChatMessage {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String        @db.ObjectId
  session   AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  sender  MessageSender // USER (Khách), AI (Bot), AGENT (Nhân viên)
  content String
  intent  String? // Mục đích nhận diện được (VD: BOOK_TABLE, MENU_INQUIRY)

  metadata Json? // Lưu trữ thông tin context (VD: {"extractedDate": "2023-12-01", "guests": 4})

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@map("ai_chat_messages")
}

// Cấu hình AI riêng cho từng Brand
model AIBrandConfig {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  brandId String @unique @db.ObjectId
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  isActive         Boolean @default(false)
  greetingMessage  String  @default("Xin chào! Tôi là trợ lý ảo của nhà hàng. Tôi có thể giúp gì cho bạn?")
  fallbackMessage  String  @default("Xin lỗi, tôi chưa hiểu ý bạn. Vui lòng đợi chút để tôi chuyển máy cho nhân viên nhé!")
  agentEscalation  Boolean @default(true) // Cho phép chuyển cho nhân viên thật khi AI không hiểu
  knowledgeBaseUrl String? // Đường dẫn tới tài liệu training (Menu, Giờ mở cửa) để RAG

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_brand_configs")
}

// 1. Table AI Chatbox (Nhà cung cấp)
model AiChatbox {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String  @unique // Vd: OpenAI, Gemini
  isActive Boolean @default(true)

  models  AiModel[]
  apiKeys ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_chatboxes")
}

// 2. Table AI Model (Các mô hình cụ thể)
model AiModel {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String // Vd: gpt-4o
  displayName String // Vd: GPT-4 Omni

  chatboxId String    @db.ObjectId
  chatbox   AiChatbox @relation(fields: [chatboxId], references: [id], onDelete: Cascade)

  // Quan hệ 1-N với ApiKey (1 Model có thể có nhiều Key bị giới hạn riêng cho nó)
  apiKeys ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_models")
}

// 3. Enum Status & Type
enum ApiKeyStatus {
  ACTIVE
  SUSPENDED // [MỚI] Tạm ngưng
  REVOKED // Thu hồi
  EXPIRED // Hết hạn
}

enum ApiKeyType {
  ADMIN // Admin
  CUSTOMER // Khách hàng
  BRAND // Thương hiệu
}

// 4. Table API Key (Cốt lõi)
model ApiKey {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String // Tên gợi nhớ

  // Bảo mật lõi
  encryptedKey String // Khóa thực tế đã bị mã hóa
  keyHash      String @unique // Hash 1 chiều để truy vấn
  prefix       String // Ký tự đầu/cuối để hiển thị (Vd: sk-123)

  // Phân loại & Phân quyền
  keyType ApiKeyType @default(BRAND)
  brandId String?    @db.ObjectId

  status       ApiKeyStatus @default(ACTIVE)
  contactEmail String? // Email người sở hữu key

  // Quan hệ (Relations)
  chatboxId         String    @db.ObjectId
  chatbox           AiChatbox @relation(fields: [chatboxId], references: [id])
  restrictedModelId String?   @db.ObjectId // [Tùy chọn] Giới hạn chỉ xài cho 1 model
  restrictedModel   AiModel?  @relation(fields: [restrictedModelId], references: [id])

  // Audit Trail (Dấu vết - Vá lỗ hổng mất dấu)
  lastUsedAt DateTime?
  lastIp     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([chatboxId])
  @@map("api_keys")
}

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Brand {
  id                  String                    @id @default(auto()) @map("_id") @db.ObjectId
  name                String                    @unique
  logo                String?
  email_contact       String?
  phone_contact       String?
  description         String?
  tax_code            String?
  link                String?
  imageMain           String
  images              String[]
  isActive            isActive                  @default(ACTIVE)
  address             Json?
  isFeatured          Boolean                   @default(false) // 👈 tiêu biểu
  new                 Boolean                   @default(true)
  restaurants         Restaurant[] // 1 Brand có nhiều Nhà hàng
  employments         Employment[] // Nhân sự cấp Brand
  menu                Menu[]
  items               MenuItem[]
  paymentConfigs      RestaurantPaymentConfig[]
  subscriptions       BrandSubscription[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  aichatSessions      AIChatSession[]
  aibrandConfig       AIBrandConfig?
  brandNotifications  BrandNotification[]
  brandPaymentConfigs BrandPaymentConfig[]
  brandRevenues       BrandRevenue[]
  invoices            Invoice[]
  restaurantRevenues  RestaurantRevenue[]
  template            Template?                 @relation(fields: [templateId], references: [id])
  templateId          String?                   @db.ObjectId

  taxConfig       BrandTaxConfig?
  inventoryConfig BrandInventoryConfig?

  @@index([isActive])
  @@index([createdAt])
  @@index([isActive, isFeatured])
  @@map("brands")
}

type BrandTaxConfig {
  isVatInclusive       Boolean @default(false)
  defaultVatRate       Float   @default(10.0)
  applyServiceCharge   Boolean @default(false)
  serviceChargeRate    Float   @default(0.0)
  forceGlobalTaxConfig Boolean @default(true)
}

type BrandInventoryConfig {
  inventoryApprovalThreshold Int @default(0)
}

model BrandNotification {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  brandId String @db.ObjectId

  targetUserId String? @db.ObjectId

  title String
  body  String
  type  NotificationType

  referenceId   String?
  referenceType String?

  createdAt DateTime @default(now())

  readReceipts BrandNotificationReadReceipt[]

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
  @@map("brand_notifications")
}

model BrandNotificationReadReceipt {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  notificationId String   @db.ObjectId
  userId         String   @db.ObjectId
  readAt         DateTime @default(now())
  isDeleted      Boolean  @default(false)

  notification BrandNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@map("brand_notification_read_receipts")
}

model BrandPaymentConfig {
  id                    String @id @default(auto()) @map("_id") @db.ObjectId
  brandId               String @db.ObjectId
  systemPaymentMethodId String @db.ObjectId

  configData Json // API keys, secret keys của Brand
  isActive   Boolean @default(true)
  isTestMode Boolean @default(true)

  brand               Brand               @relation(fields: [brandId], references: [id])
  systemPaymentMethod SystemPaymentMethod @relation(fields: [systemPaymentMethodId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, systemPaymentMethodId])
  @@index([isActive])
  @@map("brand_payment_configs")
}

model BrandRevenue {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  brandId     String  @db.ObjectId
  amount      Float
  source      String // VD: "RESTAURANT_ORDER"
  referenceId String? @db.ObjectId
  description String?

  brand Brand @relation(fields: [brandId], references: [id])

  createdAt DateTime @default(now())

  @@index([brandId])
  @@index([brandId, createdAt])
  @@index([brandId, source])
  @@map("brand_revenues")
}

model BrandSubscription {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  brandId String @db.ObjectId
  planId  String @db.ObjectId

  startDate DateTime           @default(now())
  endDate   DateTime
  status    SubscriptionStatus @default(PENDING_PAYMENT)

  brand Brand            @relation(fields: [brandId], references: [id])
  plan  SubscriptionPlan @relation(fields: [planId], references: [id])

  // Snapshot dữ liệu tại thời điểm mua
  planName       String?
  price          Float?
  maxRestaurants Int?
  featuresData   Json?

  autoRenew          Boolean   @default(false)
  currentPeriodStart DateTime? // Ngày bắt đầu kỳ cước hiện tại
