  ACTIVE // hoạt động
  INACTIVE // không dùng
  MAINTENANCE // dang sữa
}

enum MaintenanceStatus {
  SCHEDULED // Sắp diễn ra
  IN_PROGRESS // Đang bảo trì
  COMPLETED // Đã hoàn thành
