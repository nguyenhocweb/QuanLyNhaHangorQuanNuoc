model StockCount {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId String @db.ObjectId
  brandId      String @db.ObjectId
  createdBy    String @db.ObjectId

  code       String             @unique // Mã phiếu kiểm, vd: CHK-20260805-01
  status     InventoryDocStatus @default(DRAFT)
  notes      String?
  reason     String? // Lý do duyệt/từ chối
  approvedBy String?            @db.ObjectId
  approvedAt DateTime?

  items StockCountItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stock_counts")
}

model StockCountItem {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  stockCountId    String @db.ObjectId
  inventoryItemId String @db.ObjectId

  systemQty   Float @default(0) // Tồn kho trên hệ thống lúc tạo
  actualQty   Float @default(0) // Tồn kho thực tế đếm được
  discrepancy Float @default(0) // Độ lệch = actualQty - systemQty

  stockCount    StockCount    @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("stock_count_items")
}

model StockTransaction {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId    String @db.ObjectId
  inventoryItemId String @db.ObjectId
  userId          String @db.ObjectId // Người thực hiện

  type           StockTransactionType
  quantityChange Float // (+/-) Số lượng thay đổi
  balanceAfter   Float // Tồn kho SAU KHI giao dịch (Dùng để dò sai lệch)
  unitCost       Float? // Giá vốn tại thời điểm giao dịch

  referenceId String? @db.ObjectId // Tham chiếu đến PO, Order, hoặc Audit
  notes       String?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  createdAt DateTime @default(now())

  @@index([restaurantId, inventoryItemId, createdAt])
  @@map("stock_transactions")
}

model StockTransfer {
  id               String @id @default(auto()) @map("_id") @db.ObjectId
  fromRestaurantId String @db.ObjectId
  toRestaurantId   String @db.ObjectId
  createdBy        String @db.ObjectId

  transferNumber String  @unique
  status         String  @default("DRAFT") // DRAFT, IN_TRANSIT, COMPLETED, CANCELLED
  notes          String?

  items StockTransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stock_transfers")
}

model StockTransferItem {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  stockTransferId String @db.ObjectId
  inventoryItemId String @db.ObjectId

  transferQty Float // Số lượng xuất kho
  receivedQty Float @default(0) // Số lượng thực nhận

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("stock_transfer_items")
}

model SubscriptionPlan {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  name              String       @unique
  description       String?
  price             Float
  discountPrice     Float? // Giá sau khi giảm (nếu có chương trình khuyến mãi)
  discountStartDate DateTime? // Ngày bắt đầu khuyến mãi
  discountEndDate   DateTime? // Ngày kết thúc khuyến mãi
  billingCycle      BillingCycle @default(MONTHLY)
  maxRestaurants    Int // Số nhà hàng tối đa (-1 = không giới hạn)
  trialPeriodDays   Int          @default(0) // Số ngày dùng thử miễn phí
  setupFee          Float        @default(0) // Phí khởi tạo ban đầu (nếu có)
  featuresData      Json? // Thay thế features [String]. Lưu dạng {"maxUsers": 10, "maxBranches": 2, "hasAnalytics": true}
  isPublic          Boolean      @default(true) // Gói ẩn dành riêng cho Sale chốt deal Enterprise
  isActive          Boolean      @default(true)

  subscriptions BrandSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([price])
  @@index([billingCycle])
  @@index([maxRestaurants])
  @@index([isActive])
  @@index([isActive, billingCycle])
  @@map("subscription_plans")
}

