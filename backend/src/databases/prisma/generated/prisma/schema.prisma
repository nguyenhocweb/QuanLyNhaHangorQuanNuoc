}

enum ScheduleType {
  HOLIDAY // NGÀY LỄ
  SPECIAL_HOURS // thay đổi h mở của tạm thời
  PRIVATE_EVENT // sự kiện riêng
  CLOSURE // đóng tạm bảo trì....
