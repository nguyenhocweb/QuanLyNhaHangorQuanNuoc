model Reservations {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  confirmation_code String @unique // mã xác nhận để khách có thể thay đổi or hủy đặt 

  restaurantId String     @db.ObjectId
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  userId String? @db.ObjectId // khách hàng
  user   User?   @relation(fields: [userId], references: [id])

  created_by_staff_id String?     @db.ObjectId // lấy từ table employment
  created_by_staff    Employment? @relation(fields: [created_by_staff_id], references: [id])
  // thông tin khách
  guest_name          String
  guest_phone         String
  guest_email         String?

  // Booking details
  reservation_date DateTime // ngày đến  
  start_time       String // giờ khách đến 
  end_time         String // giờ khách đi

  party_size Int // số lượng ngừoi

  status ReservationStatus  @default(PENDING)
  source ReservationSource?

  // Special requests
  special_requests     String? // yêu cầu đặt biệt của khách đặt bàn
  dietary_restrictions Json? // các hạn chế và dị ứng nếu có

  occasion Occasion?

  internal_notes String? // ghi chú nội bộ nhân viên chỉ có nhân viên thấy đc

  // Payment
  deposit_paid           Boolean       @default(false) // khách đặt cọc chưa
  deposit_amount         Int? // đặt bao nhiêu
  deposit_status         PaymentStatus @default(PENDING) // trạng thái tiền cọc
  deposit_transaction_id String?       @db.ObjectId // ID giao dịch
  deposit_transaction    Transaction?  @relation(fields: [deposit_transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Timeline
  confirmed_at        DateTime? // thời gian nhân viên xác nhận đơn
  cancelled_at        DateTime? // thời gian nhân viên hủy đơn
  cancellation_reason String? // lý do hủy

  seated_at    DateTime? // thời gian khách đến
  completed_at DateTime? // thời gian khách đã dùng xong

  reservation_tables    Reservation_Tables[]
  review_restaurant     Review_Restaurant?
  reservation_audit_log Reservation_Audit_Log[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order[]

  @@index([restaurantId])
  @@index([reservation_date])
  @@index([status])
  @@map("reservations")
}

model Restaurant {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  brandId String? @db.ObjectId
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  templateId String?   @db.ObjectId
  template   Template? @relation(fields: [templateId], references: [id])

  logo          String?
  isNew         Boolean          @default(true)
  name          String?
  address       LocationAddress?
  timezone      String           @default("Asia/Ho_Chi_Minh") // Thêm timezone cho tính năng đa vùng
  emailContact  String?
  phoneContact  String?
  description   String?
  statusByAdmin isActive         @default(PENDING)
  reasonByAdmin String?
  statusByBrand isActive         @default(ACTIVE)
  reasonByBrand String?
  imageMain     String
  images        String[]
  slug          String?
  employments   Employment[] // nhẫn viên cấp nhà hàng

  restaurantAreas       Restaurant_Areas[]
  tables                Tables[] // Đã sửa lỗi chính tả từ tabels
  maxPartySize          Int?                      @default(20) // số lượng khách tối đa cho nhà hàng
  bookingWindowDays     Int?                      @default(7) // đặt trước mấy ngày
  cancellationHours     Int?                      @default(2) //   hủy trước mấy giờ
  depositRequired       Boolean                   @default(false) //  có cần đặt cọc ko
  depositPerPax         Int? // đặt cọc trước bao nhiêu mỗi đầu người (đổi từ deposit_amount)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  menu                  Menu[]
  operatingHours        Operating_Hours[]
  specialSchedules      Special_Schedules[] // giờ mở cửa or đóng đặc biệt
  reservations          Reservations[]
  inventoryAlerts       InventoryAlert[]
  aiChatSessions        AIChatSession[]
  orders                Order[]
  reviewRestaurants     Review_Restaurant[]
  menuItems             RestaurantMenuItem[]
  weightedScore         Float?                    @default(0.0)
  totalRating           Int?                      @default(0) // tổng luyowtj đánh giá
  averageRating         Float                     @default(0.0) // trung bình đánh giá
  averageFoodRating     Float                     @default(0.0) // trung bình đánh giá đồ ăn
  averageServiceRating  Float                     @default(0.0) // trung bình đnahs giá phục vụ
  averageAmbianceRating Float                     @default(0.0) // trung bình đánh giá không gian quán
  paymentConfigs        RestaurantPaymentConfig[]
  restaurantRevenues    RestaurantRevenue[]
  categoryIds           String[]                  @db.ObjectId
  categories            Category_Restaurant[]     @relation(fields: [categoryIds], references: [id])

  promotionRestaurants PromotionRestaurant[]
  events               Restaurant_Event[]
  notifications        RestaurantNotification[]

  amenityIds String[]               @db.ObjectId
  amenities  Restaurant_Amenities[] @relation(fields: [amenityIds], references: [id])

  tagIds String[] @db.ObjectId
  tags   Tags[]   @relation(fields: [tagIds], references: [id])

  policies            RestaurantPolicy[]
  socialLinks         SocialLink[]
  faqs                Faq[]
  deliveryPartners    DeliveryPartner[]
  restaurantCustomers RestaurantCustomer[]

  tableMaintenanceSchedules Table_Maintenance_Schedules[]
  purchaseRequests          PurchaseRequest[]

  // --- Cấu hình Thuế & Phí ---
  isVatInclusive     Boolean @default(false) // Giá menu đã bao gồm VAT chưa?
  defaultVatRate     Float   @default(10.0) // VAT mặc định (%)
  serviceChargeRate  Float   @default(0.0) // Phí dịch vụ (%)
  applyServiceCharge Boolean @default(false) // Có áp dụng phí dịch vụ không?

  @@index([brandId, statusByAdmin]) // Admin filter theo brand
  @@index([brandId, statusByBrand]) // Brand tự filter theo trạng thái của họ
  @@index([statusByAdmin, statusByBrand, createdAt]) // list + pagination (lọc cả 2 trạng thái)
  @@index([averageRating]) // sort rating cơ bản
  @@index([averageRating, statusByAdmin, statusByBrand]) // sort rating cho các nhà hàng còn hoạt động
  @@index([weightedScore, statusByAdmin, statusByBrand, isNew]) // đang hoạt động cả 2 phía và có điểm cao 
  @@map("restaurants")
}

