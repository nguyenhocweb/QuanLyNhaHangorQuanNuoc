  BUSINESS // Tiếp khách/Công việc
  DATE // Hẹn hò cặp đôi
  OTHER // Khác
}

enum NotificationStatus {
  PENDING // ĐANG CHỜ GỬI
  SENT // ĐÃ GỬI
  DELIVERED // ĐÃ ĐẾN THIẾT BỊ
  FAILED // GỬI LỖI
