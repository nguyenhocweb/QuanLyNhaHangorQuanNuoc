model Promotion {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  code          String       @unique
  description   String?
  discountType  DiscountType
  discountValue Int
  minOrderValue Int?
  maxDiscount   Int?

  validFrom  DateTime
  validUntil DateTime

  // === ĐIỀU KIỆN THỜI GIAN ===
  daysOfWeek DayOfWeek[] // VD: [MONDAY, TUESDAY]
  timeStart  String? // VD: "14:00"
  timeEnd    String? // VD: "17:00"

  // === ĐIỀU KIỆN KHÁCH HÀNG & MỞ RỘNG ===
  conditions Json? // Lưu trữ rules linh hoạt (tier, orderType, etc.)

  // === SỐ LƯỢNG ===
  usageLimit        Int? // Tổng số lần mã có thể dùng
  usageLimitPerUser Int? @default(1) // Mỗi user được dùng mấy lần
  usedCount         Int  @default(0)
  maxBudget         Int? // Ngân sách tối đa của khuyến mãi

  image String?

  brandId String? @db.ObjectId
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  promotionRestaurants PromotionRestaurant[]

  status    PromotionStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  userWallets        UserPromotionWallet[]
  usageLogs          PromotionUsageLog[]
  promotionMenuItems PromotionMenuItem[] // Map với món ăn

  @@map("promotions")
}

model PromotionMenuItem {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  promotionId String    @db.ObjectId
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  menuItemId  String    @db.ObjectId
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([promotionId, menuItemId])
  @@map("promotion_menu_items")
}

model UserPromotionWallet {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  user        User      @relation("UserSavedPromotions", fields: [userId], references: [id], onDelete: Cascade)
  promotionId String    @db.ObjectId
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  savedAt DateTime @default(now())

  @@unique([userId, promotionId])
  @@index([userId])
  @@map("user_promotion_wallets")
}

model PromotionUsageLog {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  promotionId    String    @db.ObjectId
  promotion      Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userId         String    @db.ObjectId
  user           User      @relation("UserUsedPromotions", fields: [userId], references: [id], onDelete: Cascade)
  orderId        String    @db.ObjectId // Khách hàng dùng cho đơn hàng nào (bắt buộc)
  discountAmount Int // Số tiền được giảm thực tế trong đơn này

  usedAt DateTime @default(now())

  @@index([userId])
  @@index([promotionId])
  @@map("promotion_usage_logs")
}

model PromotionRestaurant {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  promotionId  String     @db.ObjectId
  promotion    Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  restaurantId String     @db.ObjectId
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([promotionId, restaurantId])
  @@map("promotion_restaurants")
}
