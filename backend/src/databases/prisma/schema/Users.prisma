model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  user_name    String        @unique
  email        String        @unique
  sdt          String?
  password     String?
  providerId   String?
  providerType providerType?
  // thông tin cơ bản

  name          String?
  avatar        String?
  gender        Gender?
  date_of_birth DateTime?
  is_active     AccountStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //tạo liên kết 

  // --- Các Relations (Liên kết tới các vai trò của User) ---
  employments                   Employment[] // Liên kết: User này làm nhân viên ở đâu? có or ko 
  systemRoleId                  String                         @db.ObjectId // Liên kết : User này là khách hàng hay admin
  systemRole                    SystemRole                     @relation(fields: [systemRoleId], references: [id])
  reservations                  Reservations[] //khách hàng đặt bàn
  review_restaurant             Review_Restaurant[] // người đánh fias nhà hàng
  reservation_audit_log         Reservation_Audit_Log[] // thay đổi đặt 
  customerNotifications         CustomerNotification[]
  restaurantNotificationReceipts RestaurantNotificationReadReceipt[]
  brandNotificationReceipts      BrandNotificationReadReceipt[]
  systemNotificationReceipts     SystemNotificationReadReceipt[]
  ordersTaken                   Order[]                        @relation("EmployeeOrders")
  orders                        Order[] // Liên kết khách hàng với đơn hàng
  upgradeRequest                UpgradeRequest?
  brandSubscriptionTransactions BrandSubscriptionTransaction[]
  savedPromotions               UserPromotionWallet[]          @relation("UserSavedPromotions")
  usedPromotions                PromotionUsageLog[]            @relation("UserUsedPromotions")
  brandCustomers                BrandCustomer[]
  restaurantCustomers           RestaurantCustomer[]

  @@index([systemRoleId])
  @@index([name])
  @@index([sdt])
  @@map("users")
}
