model Brand {
  id                  String                    @id @default(auto()) @map("_id") @db.ObjectId
  name                String                    @unique
  logo                String?
  email_contact       String?
  phone_contact       String?
  description         String?
  tax_code            String?
  link                String?
  imageMain           String
  images              String[]
  isActive            isActive                  @default(ACTIVE)
  address             Json?
  isFeatured          Boolean                   @default(false) // 👈 tiêu biểu
  new                 Boolean                   @default(true)
  restaurants         Restaurant[] // 1 Brand có nhiều Nhà hàng
  employments         Employment[] // Nhân sự cấp Brand
  menu                Menu[]
  items               MenuItem[]
  paymentConfigs      RestaurantPaymentConfig[]
  subscriptions       BrandSubscription[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  aichatSessions      AIChatSession[]
  aibrandConfig       AIBrandConfig?
  brandNotifications  BrandNotification[]
  brandPaymentConfigs BrandPaymentConfig[]
  brandRevenues       BrandRevenue[]
  invoices            Invoice[]
  restaurantRevenues  RestaurantRevenue[]
  template            Template?                 @relation(fields: [templateId], references: [id])
  templateId          String?                   @db.ObjectId

  taxConfig       BrandTaxConfig?
  inventoryConfig BrandInventoryConfig?

  @@index([isActive])
  @@index([createdAt])
  @@index([isActive, isFeatured])
  @@map("brands")
}

type BrandTaxConfig {
  isVatInclusive       Boolean @default(false)
  defaultVatRate       Float   @default(10.0)
  applyServiceCharge   Boolean @default(false)
  serviceChargeRate    Float   @default(0.0)
  forceGlobalTaxConfig Boolean @default(true)
}

type BrandInventoryConfig {
  inventoryApprovalThreshold Int @default(0)
}
