model Brand {
  id                         String           @id @default(auto()) @map("_id") @db.ObjectId
  name                       String           @unique
  logo                       String?
  emailContact               String?
  phoneContact               String?
  description                String?
  taxCode                    String?
  link                       String?
  imageMain                  String?
  images                     String[]
  isActive                   isActive         @default(PENDING)
  reason                     String?
  address                    LocationAddress?
  isFeatured                 Boolean          @default(false) // 👈 tiêu biểu
  isNew                      Boolean          @default(true)
  restaurantCount            Int              @default(0) // Số lượng nhà hàng hiện có
  inventoryApprovalThreshold Int              @default(0) // Hạn mức tự duyệt phiếu kiểm kê của Quản lý nhà hàng

  templateId String?   @db.ObjectId
  template   Template? @relation(fields: [templateId], references: [id])

  subscriptions       BrandSubscription[] // Lịch sử các gói cước đã đăng ký
  invoices            Invoice[]
  restaurants         Restaurant[] // 1 Brand có nhiều Nhà hàng
  notifications       BrandNotification[]
  employments         Employment[] // Nhân sự cấp Brand
  menu                Menu[]
  menuCategories      MenuCategory[]
  items               MenuItem[]
  paymentConfigs      RestaurantPaymentConfig[]
  brandPaymentConfigs BrandPaymentConfig[]
  brandRevenues       BrandRevenue[]
  restaurantRevenues  RestaurantRevenue[]
  promotions          Promotion[]
  brandCustomers      BrandCustomer[]
  aiChatSessions      AIChatSession[]
  aiBrandConfig       AIBrandConfig?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  // --- Cấu hình Thuế & Phí cấp độ Toàn chuỗi ---
  isVatInclusive       Boolean @default(false)
  defaultVatRate       Float   @default(10.0)
  serviceChargeRate    Float   @default(0.0)
  applyServiceCharge   Boolean @default(false)
  forceGlobalTaxConfig Boolean @default(true) // Ép toàn bộ nhà hàng dùng cấu hình của Brand

  @@index([isActive])
  @@index([createdAt])
  @@index([isActive, isFeatured])
  @@map("brands")
}

model BrandCustomer {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  brandId String @db.ObjectId
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId  String @db.ObjectId
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalSpent    Int          @default(0)
  loyaltyPoints Float        @default(0)
  orderCount    Int          @default(0)
  tier          CustomerTier @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, userId])
  @@map("brand_customers")
}
