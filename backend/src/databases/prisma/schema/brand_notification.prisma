model BrandNotification {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  brandId String @db.ObjectId

  targetUserId String? @db.ObjectId

  title String
  body  String
  type  NotificationType

  referenceId   String?
  referenceType String?

  createdAt DateTime @default(now())

  readReceipts BrandNotificationReadReceipt[]

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
  @@map("brand_notifications")
}

model BrandNotificationReadReceipt {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  notificationId String   @db.ObjectId
  userId         String   @db.ObjectId
  readAt         DateTime @default(now())
  isDeleted      Boolean  @default(false)

  notification BrandNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@map("brand_notification_read_receipts")
}
