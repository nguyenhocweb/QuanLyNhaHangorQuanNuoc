model ContactTicket {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  ticketCode      String         @unique // Mã tra cứu: TK-123456
  guestName       String
  guestEmail      String
  guestPhone      String?
  hasZalo         Boolean        @default(false)
  subject         String?
  message         String
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(MEDIUM)
  adminNote       String?        // Ghi chú nội bộ của CSKH
  adminReply      String?        // Phản hồi đã gửi cho khách
  assignedTo      String?        // Tên nhân viên tiếp nhận
  ipAddress       String?
  deviceInfo      String?
  resolvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_tickets")
}
