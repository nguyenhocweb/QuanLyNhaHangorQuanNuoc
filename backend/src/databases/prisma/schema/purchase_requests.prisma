model PurchaseRequest {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  brandId      String    @db.ObjectId
  restaurantId String    @db.ObjectId
  requestCode  String    @unique // e.g. PR-12345
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  notes        String?
  expectedDate DateTime?

  items PurchaseRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  // Back-relations might be needed in Restaurant and Brand models, but if Prisma complains we will add them.
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String @id @default(auto()) @map("_id") @db.ObjectId
  purchaseRequestId String @db.ObjectId
  inventoryItemId   String @db.ObjectId
  requestedQty      Float
  approvedQty       Float?

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem   @relation(fields: [inventoryItemId], references: [id])

  @@map("purchase_request_items")
}
