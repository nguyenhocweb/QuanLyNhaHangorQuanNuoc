type RestaurantBookingConfig {
  maxPartySize      Int?
  bookingWindowDays Int?
  cancellationHours Int?
  depositRequired   Boolean @default(false)
  depositAmount     Int?
}

type RestaurantRatingStats {
  totalRating   Int?
  averageRating Float @default(0.0)
  food          Float @default(0.0)
  service       Float @default(0.0)
  ambiance      Float @default(0.0)
}

model Restaurant {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  brandId       String       @db.ObjectId
  brand         Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  logo          String?
  isNew         Boolean      @default(true)
  name          String?
  address       Json?
  city          String?
  email_contact String?
  phone_contact String?
  description   String?
  statusByAdmin isActive     @default(ACTIVE)
  reasonByAdmin String?
  statusByBrand isActive     @default(ACTIVE)
  reasonByBrand String?
  imageMain     String
  images        String[]
  slug          String?
  employments   Employment[] // nhẫn viên cấp nhà hàng

  restaurant_areas Restaurant_Areas[]
  tabels           Tables[]

  // 1. Nhóm Cấu hình Đặt bàn
  bookingConfig RestaurantBookingConfig?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  menu              Menu[]
  operating_hours   Operating_Hours[]
  special_schedules Special_Schedules[] // giờ mở cửa or đóng đặc biệt
  reservations      Reservations[]
  review_restaurant Review_Restaurant[]
  items             MenuItem[]
  weightedScore     Float?

  // 2. Nhóm Điểm số Đánh giá
  ratingStats RestaurantRatingStats?

  // 3. Nhóm Cấu hình Thuế & Kho (kế thừa từ Brand)
  taxConfig             BrandTaxConfig?
  inventoryConfig       BrandInventoryConfig?
  paymentConfigs        RestaurantPaymentConfig[]
  // Quan h n-n
  categoryRestaurantIds String[]                  @db.ObjectId
  categoryRestaurants   Category_Restaurant[]     @relation(fields: [categoryRestaurantIds], references: [id])

  restaurantAmenityIds String[]               @db.ObjectId
  restaurantAmenities  Restaurant_Amenities[] @relation(fields: [restaurantAmenityIds], references: [id])

  tagIds                    String[]                      @db.ObjectId
  tags                      Tags[]                        @relation(fields: [tagIds], references: [id])
  restaurantMenuItems       RestaurantMenuItem[]
  aichatSessions            AIChatSession[]
  inventoryAlerts           InventoryAlert[]
  purchaseRequests          PurchaseRequest[]
  restaurantCustomers       RestaurantCustomer[]
  restaurantEvents          Restaurant_Event[]
  restaurantNotifications   RestaurantNotification[]
  restaurantRevenues        RestaurantRevenue[]
  tableMaintenanceSchedules Table_Maintenance_Schedules[]
  template                  Template?                     @relation(fields: [templateId], references: [id])
  templateId                String?                       @db.ObjectId
  orders                    Order[]
  promotionRestaurants      PromotionRestaurant[]

  @@index([brandId, statusByAdmin]) // theo brand
  @@index([statusByAdmin, createdAt]) // list + pagination
  @@index([city, statusByAdmin]) // filter location
  @@index([weightedScore, statusByAdmin, isNew]) // đang hoạt động và có điểm cao 
  @@map("restaurants")
}
