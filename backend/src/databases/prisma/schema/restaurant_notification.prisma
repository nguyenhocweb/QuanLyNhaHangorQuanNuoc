model RestaurantNotification {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId   String   @db.ObjectId 
  
  targetUserId   String?  @db.ObjectId

  title          String
  body           String
  type           NotificationType 
  
  referenceId    String?
  referenceType  String?
  
  createdAt      DateTime @default(now())

  readReceipts   RestaurantNotificationReadReceipt[]

  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  @@index([restaurantId, createdAt])
  @@map("restaurant_notifications")
}

model RestaurantNotificationReadReceipt {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  notificationId String @db.ObjectId
  userId         String @db.ObjectId 
  readAt         DateTime @default(now())
  isDeleted      Boolean  @default(false)
  
  notification   RestaurantNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([notificationId, userId])
  @@map("restaurant_notification_read_receipts")
}
