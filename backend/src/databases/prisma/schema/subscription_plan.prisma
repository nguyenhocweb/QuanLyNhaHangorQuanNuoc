model SubscriptionPlan {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  name              String       @unique
  description       String?
  price             Float
  discountPrice     Float? // Giá sau khi giảm (nếu có chương trình khuyến mãi)
  discountStartDate DateTime? // Ngày bắt đầu khuyến mãi
  discountEndDate   DateTime? // Ngày kết thúc khuyến mãi
  billingCycle      BillingCycle @default(MONTHLY)
  maxRestaurants    Int // Số nhà hàng tối đa (-1 = không giới hạn)
  trialPeriodDays   Int          @default(0) // Số ngày dùng thử miễn phí
  setupFee          Float        @default(0) // Phí khởi tạo ban đầu (nếu có)
  featuresData      Json? // Thay thế features [String]. Lưu dạng {"maxUsers": 10, "maxBranches": 2, "hasAnalytics": true}
  isPublic          Boolean      @default(true) // Gói ẩn dành riêng cho Sale chốt deal Enterprise
  isActive          Boolean      @default(true)

  subscriptions BrandSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([price])
  @@index([billingCycle])
  @@index([maxRestaurants])
  @@index([isActive])
  @@index([isActive, billingCycle])
  @@map("subscription_plans")
}
