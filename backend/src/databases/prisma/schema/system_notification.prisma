model SystemNotification {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  
  targetUserId   String?  @db.ObjectId

  title          String
  body           String
  type           NotificationType 
  
  referenceId    String?
  referenceType  String?
  
  createdAt      DateTime @default(now())

  readReceipts   SystemNotificationReadReceipt[]
  
  @@index([createdAt])
  @@map("system_notifications")
}

model SystemNotificationReadReceipt {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  notificationId String @db.ObjectId
  userId         String @db.ObjectId 
  readAt         DateTime @default(now())
  isDeleted      Boolean  @default(false)
  
  notification   SystemNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([notificationId, userId])
  @@map("system_notification_read_receipts")
}
