model SystemRevenue {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  amount      Float
  source      String // VD: "BRAND_SUBSCRIPTION", "SERVICE_FEE"
  referenceId String? @db.ObjectId
  description String?

  createdAt DateTime @default(now())

  @@index([source])
  @@index([createdAt])
  @@index([source, createdAt])
  @@map("system_revenues")
}
