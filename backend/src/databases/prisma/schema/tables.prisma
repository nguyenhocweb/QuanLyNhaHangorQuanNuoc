// tạo tabels cho nhà hàng 

model Tables {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  restaurantId String     @db.ObjectId
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  areaId       String           @db.ObjectId
  area         Restaurant_Areas @relation(fields: [areaId], references: [id])
  is_vip       Boolean          @default(false)
  table_number String
  table_type   TableType @default(STANDARD) // Phân loại bàn

  min_capacity Int // số lượng khách ít nhất
  max_capacity Int // số lượng khách nhiều nhất

  shape         TableShape?
  color         String?
  is_combinable Boolean?    @default(false) // cho phép ghép table vs người khác hay không

  pos_x Float? //  sơ đồ tọa độ X
  pos_y Float? //  tọa độ Y
  width Float? @default(80)    // Chiều rộng hiển thị trên sơ đồ
  height Float? @default(80)   // Chiều cao hiển thị trên sơ đồ
  rotation Float? @default(0)  // Góc xoay của bàn

  status TableStatus @default(ACTIVE)

  qr_code            String?              @unique // mở link để đặt món tiếp
  reservation_tables Reservation_Tables[] // bàn đc phân khi có đơn đặt 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  maintenanceScheduleIds String[]                      @db.ObjectId
  maintenance_schedules  Table_Maintenance_Schedules[] @relation(fields: [maintenanceScheduleIds], references: [id])


  @@unique([restaurantId, table_number])
  @@map("tables")
}
