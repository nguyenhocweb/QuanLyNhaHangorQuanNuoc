datasource db { provider = "mongodb" url = "mongodb://localhost" } generator client { provider = "prisma-client-js" } model Post { id String @id @default(auto()) @map("_id") @db.ObjectId categoryIds String[] @db.ObjectId categories Category[] @relation(fields: [categoryIds], references: [id]) } model Category { id String @id @default(auto()) @map("_id") @db.ObjectId postIds String[] @db.ObjectId posts Post[] @relation(fields: [postIds], references: [id]) }